/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-deepseek",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "deepseek-memory"
		}
	],
	"routes": [
		// Reemplaza example.com con tu propio dominio (o elimina este bloque para usar solo *.workers.dev)
		{
			"pattern": "example.com",
			"custom_domain": true
		}
	],
	"vars": {
		"EXPOSED_MODEL": "deepseek-v4-flash-cloudflare",
		"CLOUDFLARE_MODEL": "@cf/deepseek-ai/deepseek-v4-flash-0731",
		"EMBEDDING_MODEL": "@cf/baai/bge-m3"
	}
}