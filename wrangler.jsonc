/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-deepseek",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-25",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "deepseek-memory"
		}
	],
	"vars": {
		"EXPOSED_MODEL": "deepseek-v4.1-flash-cloudflare",
		"CLOUDFLARE_MODEL": "@cf/deepseek-ai/deepseek-v4.1-flash-1017",
		"EMBEDDING_MODEL": "@cf/baai/bge-m3"
	}
	// Custom domain (opcional): añade tu propio dominio, que debe ser una zona de tu cuenta de Cloudflare.
	// Si no defines rutas, el Worker se publica en <name>.<subdominio>.workers.dev
	// "routes": [
	// 	{
	// 		"pattern": "example.com",
	// 		"custom_domain": true
	// 	}
	// ]
}
